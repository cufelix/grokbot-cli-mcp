{
  "name": "grokbot-cli-mcp",
  "version": "0.1.1",
  "description": "Grok coding agent for your terminal (built on pi) and an MCP server so Claude Code can use Grok: X/web search, vision, image/video generation and full agent delegation.",
  "type": "module",
  "bin": {
    "grokbot": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "grok",
    "xai",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cli",
    "coding-agent",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cufelix/grokbot-cli-mcp.git"
  },
  "homepage": "https://github.com/cufelix/grokbot-cli-mcp#readme",
  "bugs": "https://github.com/cufelix/grokbot-cli-mcp/issues",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@ai-sdk/xai": "3.0.145",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "6.0.315",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
